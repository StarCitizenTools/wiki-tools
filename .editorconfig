root = true

[*]
indent_style = tab
indent_size = tab
tab_width = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

# Ensure text editors don't turn leading spaces into tabs,
# e.g. in multi-line bullet list items
[*.md]
indent_style = space
indent_size = 2

# Tabs may not be valid YAML
# @see https://yaml.org/spec/1.2/spec.html#id2777534
[*.{yml,yaml}]
indent_style = space
indent_size = 2

[.git/**]
indent_style = space
indent_size = 2

# A byte-for-byte capture of what the wiki serves for
# Module:SystemMap/systems.json, used as the generator's acceptance baseline.
# MediaWiki stores no trailing newline, and an editor adding one would make the
# fixture stop being the thing it claims to be.
[scripts/internal/systemmap/testdata/systems.live.json]
insert_final_newline = false
